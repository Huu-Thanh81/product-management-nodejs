extends ../../layouts/default.pug
include ../../mixins/alert.pug
block main-content
  // Card Chi tiết sản phẩm
  .card.border-0.shadow-sm.rounded-4.overflow-hidden
    h2.card-title.fw-bold.text-dark.mb-4 Chi tiết sản phẩm
    .row.g-0
      // Cột 1: Hiển thị hình ảnh
      .col-md-5.bg-body-tertiary.d-flex.align-items-center.justify-content-center.p-4.border-end.border-light
        img.img-fluid.rounded-3(src=products.thumbnail style='max-height: 180px; object-fit: contain;' alt='Tree Oil 30ml')
      // Cột 2: Thông tin chi tiết
      .col-md-7
        .card-body.p-4.d-flex.flex-column.h-100
          // Trạng thái & Vị trí
          .d-flex.justify-content-between.align-items-center.mb-3
            if (products.status === "inactive")  
              span.badge.bg-danger-subtle.text-danger.border.border-danger-subtle.rounded-pill.px-3.py-2.fw-medium
                i.bi.bi-exclamation-circle.me-1
                | D&#x1EEB;ng ho&#x1EA1;t &dstrok;&#x1ED9;ng
            else 
              span.badge.bg-success-subtle.text-success.border.border-success-subtle.rounded-pill.px-3.py-2.fw-medium
                i.bi.bi-exclamation-circle.me-1
                | Đang hoạt động
            span.badge.bg-light.text-secondary.border.px-2.py-1
              i.bi.bi-geo-alt.me-1
              | V&#x1ECB; tr&iacute;:  #{products.position}
              strong 19
          // Tên sản phẩm
          h3.card-title.fw-bold.text-dark.mb-3 #{products.title}
          // Bảng thống kê thông số
          .p-3.bg-light.rounded-3.mb-3.border.border-light-subtle
            .row.text-center.g-2
              .col-4.border-end
                .text-muted.small Gi&aacute;
                .fw-bold.text-primary.fs-5 #{products.price}
              .col-4.border-end
                .text-muted.small Gi&#x1EA3;m gi&aacute;
                .fw-bold.text-danger.fs-5 #{products.discountPercentage}
              .col-4
                .text-muted.small C&ograve;n l&#x1EA1;i
                .fw-bold.text-dark.fs-5 #{products.stock}
          // Mô tả
          p.card-text.text-secondary.small.mb-4.flex-grow-1
            | #{products.description}
          // Nút thao tác
          .mt-auto
            a(href=`${prefixAdmin}/product/edit/${products.id}`)
              button.btn.btn-warning.text-dark.fw-bold.w-100.rounded-3.shadow-sm.py-2
                i.bi.bi-pencil-square.me-2
                | Ch&#x1EC9;nh s&#x1EED;a
  // End Card