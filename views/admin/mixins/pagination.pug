mixin pagination (pagination)
    //- trang đầu
    if(pagination.currentPage == 1)
      - for(var i = 1; i <= pagination.showPagination; ++i)
          li(class = "page-item", aria-current=`${i}` )
            button(class = `page-link ${pagination.currentPage === i ? "active": ""}`)  #{i}
      if(pagination.currentPage < pagination.totalPage )
        li(class = "page-item", aria-current=`${pagination.currentPage + 1}`)
          button.page-link Kế tiếp
    //- trang cuối
    else if (pagination.currentPage == pagination.totalPage)
      li(class = "page-item", aria-current=`${pagination.currentPage-1}`)
        button.page-link Trang trước
      - for(var i = pagination.totalPage - pagination.showPagination + 1; i <= pagination.totalPage; i++)
          li(class = "page-item", aria-current=`${i}` )
            button(class = `page-link ${pagination.currentPage === i ? "active": ""}`)  #{i}
    //- trang giữa
    else 
      li(class = "page-item", aria-current=`${pagination.currentPage-1}`)
        button.page-link Trang trước
      - for(var i = pagination.currentPage - 1; i <= pagination.currentPage + 1; ++i)
        li(class = "page-item", aria-current=`${i}` )
          button(class = `page-link ${pagination.currentPage === i ? "active": ""}`)  #{i}
      li(class = "page-item", aria-current=`${pagination.currentPage + 1}`)
        button.page-link Kế tiếp