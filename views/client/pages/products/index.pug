extends ../../layouts/default.pug
include ../../mixins/box-head.pug
block main
  main.container.my-5
    // Page Title
    +box-head("Danh sách sản phẩm")
    // Product Grid (Bootstrap Responsive Grid)
    .row.row-cols-1.row-cols-sm-2.row-cols-md-3.row-cols-lg-4.g-4
      each item in products
        .col-3
          .card.h-100.border-0.shadow-sm.rounded-4.overflow-hidden.product-card
            // Square Image Box using Bootstrap Ratio
            .position-relative.ratio.ratio-1x1.bg-dark.overflow-hidden
              img.card-img-top(src=item.thumbnail alt=item.title)
            // Card Body
            .card-body.d-flex.flex-column.p-4
              a(href=`/products/${item.slug}`)
                h2.card-title.h5.fw-bold.text-dark.mb-3 #{item.title}
              .d-flex.align-items-baseline.gap-2.mb-3
                .fs-4.fw-bold.text-brand-green #{item.price}$
                if item.discountPercentage > 0
                  .fs-6.fw-bold.text-danger.text-decoration-line-through.fw-medium #{item.newPrice}$
                  .fs-6.text-bg-danger.p-1.badge.fw-medium -#{item.discountPercentage}%
              button.btn.btn-outline-success.mt-auto.w-100.fw-semibold.py-2.rounded-3 Thêm vào giỏ hàng