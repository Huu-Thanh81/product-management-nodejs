extends ../../layouts/default.pug
include ../../mixins/box-head.pug
block main
  .card-body.p-4.p-md-5
    .row.g-4.align-items-center
      // Product Image Column
      .col-md-5.text-center
        .bg-light.p-4.rounded-4.border.d-inline-block.w-100
          img.img-fluid.rounded-3.shadow-sm(src=products.thumbnail alt=products.title)
      // Product Info Column
      .col-md-7
        .d-flex.align-items-center.gap-2.mb-2
          span.badge.bg-danger.fs-6.px-3.py-2.rounded-pill - #{products.discountPercentage}% GIẢM
        h1.fw-bold.mb-3.display-6 #{products.title}
        // Price & Stock
        .p-3.bg-light.rounded-3.mb-3
          .d-flex.align-items-baseline.gap-3 
            span.fs-2.fw-bold.text-primary #{products.newPrice}$
            span.fs-5.text-muted.text-decoration-line-through #{products.price}$
          p.text-success.fw-semibold.mb-0.mt-1.small
            i.bi.bi-box-seam.me-1
            |  C&ograve;n l&#x1EA1;i trong kho:  
            strong  #{products.stock}$ 
        // Description
        .mb-4
          h6.fw-bold.text-uppercase.text-muted.fs-7.mb-1 M&ocirc; t&#x1EA3; s&#x1EA3;n ph&#x1EA9;m
          p.text-secondary.mb-0
            | #{products.description}
        // Action Buttons
        .d-flex.gap-2
          button.btn.btn-primary.btn-lg.px-4.rounded-3.fw-medium
            i.bi.bi-cart-plus.me-2
            | Th&ecirc;m v&agrave;o gi&#x1ECF;
          button.btn.btn-outline-dark.btn-lg.px-4.rounded-3.fw-medium Mua ngay
